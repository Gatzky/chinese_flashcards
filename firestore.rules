rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/appData/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll([
          'type', 'description', 'appVersion', 'deckName', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'type', 'description', 'appVersion', 'deckName', 'createdAt', 'userId', 'userEmail'
        ])
        && request.resource.data.type is string
        && request.resource.data.type in ['Bug report', 'Feature request', 'Other feedback']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 4000
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 40
        && request.resource.data.deckName is string
        && request.resource.data.deckName.size() <= 60
        && request.resource.data.createdAt == request.time
        && (
          (
            !('userId' in request.resource.data)
            && !('userEmail' in request.resource.data)
          )
          || (
            request.auth != null
            && 'userEmail' in request.resource.data
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.userEmail == request.auth.token.email
          )
        );

      allow get, list: if request.auth != null
        && request.auth.token.email == 'gacbartlomiej96@gmail.com'
        && request.auth.token.email_verified == true;

      allow update: if request.auth != null
        && request.auth.token.email == 'gacbartlomiej96@gmail.com'
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priority'])
        && request.resource.data.priority in ['low', 'normal', 'high'];

      allow delete: if request.auth != null
        && request.auth.token.email == 'gacbartlomiej96@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}